# aarch64 (D-Robotics X5) build environment for DBoW3 + pydbow3_shim.
#
# The X5 inside the Looper camera runs an Ubuntu 22.04 userspace (glibc 2.35,
# Python 3.10) but ships no compiler and no OpenCV, so everything is
# cross-built here under qemu-aarch64 binfmt:
#
#   DOCKER_BUILDKIT=0 docker build --platform linux/arm64 \
#       -t tinynav-x5:dbow3-arm64 -f Dockerfile.aarch64 .
#
# This image only carries the toolchain + DBoW3; the shim itself is compiled by
# build_aarch64.sh so it can be iterated on without re-running apt under qemu.
FROM arm64v8/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ \
        make \
        cmake \
        git \
        ca-certificates \
        patchelf \
        python3-dev \
        python3-numpy \
        pybind11-dev \
        libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

# Pin the DBoW3 revision so the shipped .so is reproducible.
ARG DBOW3_COMMIT=1cc587bbfc08c0adb0ea2d00d81ad6cd4103ce39
RUN git clone https://github.com/rmsalinas/DBow3.git /src/DBow3 \
    && git -C /src/DBow3 checkout "${DBOW3_COMMIT}" \
    && git -C /src/DBow3 rev-parse HEAD > /src/DBoW3.commit \
    && cmake -S /src/DBow3 -B /src/DBow3/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DUSE_CONTRIB=OFF \
        -DBUILD_UTILS=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /src/DBow3/build -j"$(nproc)" \
    && cmake --install /src/DBow3/build \
    && ldconfig
