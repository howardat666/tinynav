[Unit]
Description=Heal the WiFi link when the gateway stops answering
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/sbin/board_netheal.py
Restart=always
RestartSec=10
# 2026-08-27 实测定案后打开：整条四级梯度对"关联死亡"完全无效（跑两遍全败，
# 连固件自己的 wifi-connect.sh 也关联不上），重启是唯一能救的手段。不会重启循环 ——
# netheal 只在"曾经通过一次"之后才布防，所以 AP/网关那头挂了不会触发。
# 2026-09-21 关掉。日志实证它自己重启过板子 15 次，而板子共有 167 次原因不明的重启 ——
# 它在销毁证据。且第 1 级梯度 dhcp-renew 曾 34 次全是自杀(rc=-15)从没生效，导致它比本该
# 发生的更容易一路升到重启这一级。重启后进程退出、Restart=always 拉起新的，失败计数/梯度
# 级数/退避全在内存里 => 跨重启零抑制，无上限循环。
# 恢复能力要以"死人开关 + 按次数落盘的预算"形态还回来，别直接把这里改回 1。
Environment=NETHEAL_ALLOW_REBOOT=0

[Install]
WantedBy=multi-user.target
